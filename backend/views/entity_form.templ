
package views
templ AgregarForm() {
           
    <section id="lista-procesos">
        <form  hx-post="/procesos" hx-target="#lista-procesos" hx-swap="outerHTML" class="form">
            <fieldset>
                <legend>Crear proceso</legend>

                <label for="nombre">Nombre</label>
                <input name="nombre" id="nombre" type="text" value="Example" placeholder="Ingrese el nombre del proceso" />

                <label for="prioridad">Prioridad</label>
                <input type="number" name="prioridad" id="prioridad" value="0" placeholder="Ingrese la prioridad del proceso" />

                <label for="burst_time">Burst Time</label>
                <input type="number" name="burst_time" id="burst_time" value="1" placeholder="Ingrese el burst time del proceso" required />

                <label for="arrival_time">Arrival time</label>
                <input type="number" name="arrival_time" id="arrival_time" value="0" placeholder="Ingrese el arrival time del proceso" required />

                <input type="hidden" name="estado" id="estado" value="new"/>


                <button class="button" type="submit">Enviar</button>
            </fieldset>
        </form>
    </section>
}
