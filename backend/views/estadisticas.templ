package views
import (
    db "scheduler_os/backend/db/sqlc"
)

templ EstadisticasView(simulacion db.Simulacion, procesos []db.Proceso) {
    <section id="estadisticas" class="card">
        <h2>Simulación ID: { simulacion.ID }</h2>

        <ul class="card-footer">
            <li>Nombre: { simulacion.Nombre }</li>
            <li>Algoritmo: { simulacion.Algoritmo }</li>
            if simulacion.Quantum.Valid {
            <li>Quantum: { simulacion.Quantum.Int32 }</li>
            }
            if simulacion.Prioridad.Valid {
                <li>Prioridad: { simulacion.Prioridad.Int32 }</li>
            }
            <li>Tiempo de Proceso: { simulacion.ProcessTime }</li>
            <li>Tiempo de Despacho: { simulacion.DispatchLatency }</li>
            <li>Tiempo Promedio de Turnaround: { simulacion.AverageTurnaroundTime }</li>
            <li>Tiempo Promedio de Waiting time: { simulacion.AverageWaitingTime }</li>
            <li>Rendimiento Promedio/Throughput: { simulacion.AverageThroughput }</li>
            <li>Cambios: { simulacion.ContextSwitches }</li>
                
        </ul>
        <details>
            <summary>Haz clic aquí para ver el listado de procesos </summary>
            <div id="listado-procesos">
                @ListarProcesos(procesos, "")
            </div>
        </details>
    </section>
}



