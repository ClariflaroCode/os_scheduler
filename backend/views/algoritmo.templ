package views

templ AgregarSimulacion()    {
        <form action="/simulacionForm" method="post" class="form">

            <fieldset>
                <legend>Nueva simulacion</legend>
                
                <label for="nombre">Nombre de la simulacion</label>
                <input type="text" name="nombre" id="nombre" placeholder="Nombre de la simulacion">
                
                <label for="process_time">Process time</label>
                <input type="number" name="process_time" id="process_time" placeholder="Ingrese el process time">

                <label for="context_switches">Context switches</label>
                <input type="number" name="context_switches" id="context_switches" placeholder="Ingrese el context_switch">

                <label for="algoritmo">Elegir el algoritmo de planificacion</label>
                <select id="algoritmo" name="algoritmo">
                    <option value="first_come_first_serve">First come First Serve</option>
                    <option value="round_robin">Round Robin</option>
                    <option value="priority">Prioridad</option>
                </select>
                
                <label for="quantum" id="quantum-label">
                    <h5>Quantum</h5>
                    <input type="number" name="quantum" id="quantum" placeholder="Ingrese el quantum">
                
                </label>
                <button type="submit" class="button">Enviar</button>
            </fieldset>
        </form>

}